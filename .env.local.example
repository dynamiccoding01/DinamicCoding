# ============================================================================
# Dynamic Coding — variables de entorno
# ----------------------------------------------------------------------------
# 1) Copia este archivo a ".env.local" (y pon los mismos valores en Vercel →
#    Settings → Environment Variables).
# 2) Rellena los valores desde tu proyecto de Supabase:
#      Supabase → Project Settings → Data API / API Keys
# 3) Reinicia el servidor (npm run dev). En Vercel: Redeploy.
#
# Mientras estas variables NO estén definidas, el sitio funciona en "modo demo"
# usando los datos de ejemplo de /src/lib/seed.ts
# ============================================================================

# URL del proyecto (ej: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA: "publishable" (sb_publishable_…) o la "anon" legacy.
# Es pública por diseño y está protegida por RLS.
# NUNCA pongas aquí la "secret" / "service_role": esa es solo para el admin.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) URL pública del sitio. En Vercel no hace falta: se usa el dominio
# de producción del proyecto. Úsala si quieres forzar un dominio concreto.
# NEXT_PUBLIC_SITE_URL=https://dinamic-coding.vercel.app

# (Opcional) Token de GitHub, sin permisos especiales. Los perfiles del equipo
# leen datos públicos de GitHub; sin token el límite es de 60 consultas por
# hora, con token sube a 5.000. Es secreto: NO lleva el prefijo NEXT_PUBLIC_.
# GITHUB_TOKEN=
